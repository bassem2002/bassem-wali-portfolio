{
  "name": "bassem-wali-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "dev": "node scripts/astro.mjs dev",
    "build": "node scripts/astro.mjs build",
    "build:qa": "npm run check:data && node scripts/astro.mjs build --qa --outDir .qa/qa-build",
    "prebuild": "npm run check:data",
    "preview": "node scripts/astro.mjs preview",
    "typecheck": "node scripts/astro.mjs check",
    "lint": "eslint .",
    "test": "node --test tests/*.test.ts",
    "check:links": "node scripts/check-links.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:v2": "node scripts/check-v2.mjs",
    "check:v3": "node scripts/check-v3.mjs",
    "check:v3-1": "node scripts/check-v3-1.mjs",
    "check:v3-2": "node scripts/check-v3-2.mjs",
    "check:seo": "node scripts/check-i18n-seo.mjs",
    "check:design-system": "node scripts/check-design-system.mjs",
    "check:data": "node scripts/check-content.ts",
    "report:data": "node scripts/check-content.ts --report"
  },
  "dependencies": {
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^24.0.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "playwright-core": "^1.64.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
