---
import { profile } from '@/data/profile';
import type { Locale } from '@/types/content';
interface Props { locale: Locale }
const year = new Intl.DateTimeFormat('fr-FR', { timeZone: 'Europe/Paris', year: 'numeric' }).format(new Date());
---
<footer class="container site-footer">
  <p>© {year} {profile.name} · {profile.location[Astro.props.locale]}</p>
  <div class="cluster site-footer__links">
    <a class="text-link" href={profile.links.github}>GitHub</a>
    <a class="text-link" href={profile.links.linkedin}>LinkedIn</a>
    <a class="text-link" href={`mailto:${profile.email}`}>Email</a>
  </div>
</footer>
