---
import type { Locale } from '@/types/content';
import { pageCopy } from '@/i18n/pages';
interface Props { id: string; title: string; description: string; steps: readonly string[]; locale: Locale }
const { id, title, description, steps, locale } = Astro.props;
const height = steps.length * 88 - 16;
---
<figure class="architecture-diagram" aria-labelledby={`${id}-heading`}>
  <h3 id={`${id}-heading`}>{title}</h3>
  <svg viewBox={`0 0 320 ${height}`} role="img" aria-labelledby={`${id}-title ${id}-description`}>
    <title id={`${id}-title`}>{title}</title>
    <desc id={`${id}-description`}>{steps.map(step => step.replace('|', ' — ')).join(' → ')}. {description}</desc>
    <defs><marker id={`${id}-arrow`} markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto"><path d="M 0 0 L 8 4 L 0 8 z" fill="currentColor" /></marker></defs>
    {steps.map((step, index) => <>
      <rect x="8" y={index * 88 + 2} width="304" height="64" rx="3" />
      <text x="160" y={index * 88 + (step.includes('|') ? 27 : 39)} text-anchor="middle">
        {step.split('|').map((line, lineIndex) => <tspan x="160" dy={lineIndex ? 22 : 0}>{line}</tspan>)}
      </text>
      {index < steps.length - 1 && <line x1="160" y1={index * 88 + 68} x2="160" y2={index * 88 + 82} marker-end={`url(#${id}-arrow)`} />}
    </>)}
  </svg>
  <figcaption>{description}</figcaption>
  <details><summary>{pageCopy[locale].diagramText}</summary><ol>{steps.map(step => <li>{step.replace('|', ' — ')}</li>)}</ol></details>
</figure>
