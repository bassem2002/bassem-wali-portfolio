---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArchitectureDiagram from '@/components/ArchitectureDiagram.astro';
import TechTag from '@/components/ui/TechTag.astro';
import ExternalLink from '@/components/ui/ExternalLink.astro';
import { projectSchema } from '@/utils/seo';
import { relatedProjects } from '@/utils/related-projects';
import { projects } from '@/data/projects';
import { categories } from '@/data/categories';
import { technologyNames } from '@/data/skills';
import { pageCopy } from '@/i18n/pages';
import { skillName } from '@/i18n/skills';
import { localizedPath } from '@/i18n/routes';
import { ui } from '@/i18n/ui';
import { caseStories } from '@/data/case-stories';
import ShowcaseVisual from '@/components/ShowcaseVisual.astro';
import ProjectFacts from '@/components/ProjectFacts.astro';
import VideoDemoLink from '@/components/VideoDemoLink.astro';
import type { Project } from '@/types/content';
import '@/styles/case-studies.css';
interface Props { project: Project; entry: CollectionEntry<'caseStudies'> }
const { project, entry } = Astro.props;
const locale = entry.data.locale;
const story = caseStories[project.id];
if (!story) throw new Error(`Missing case narrative: ${project.id}`);
const copy = pageCopy[locale];
const { Content, headings } = await render(entry);
const related = relatedProjects(project, projects);
const heroTechnologies = entry.data.heroTechnologies ?? project.technologies.slice(0, 5);
const demonstrated = entry.data.demonstratedSkills ?? [];
if (!heroTechnologies.every(id => project.technologies.includes(id)) || !demonstrated.every(id => project.relatedSkills.includes(id))) throw Error(`Unverified case study skills: ${project.id}`);
const nav = [
  { slug: 'overview', text: copy.overview },
  { slug: 'features', text: copy.featuresNav },
  { slug: 'architecture', text: copy.architectureNav },
  ...headings.filter(heading => heading.depth === 2 && [copy.decisions, copy.limitations].includes(heading.text)),
];
---
<BaseLayout locale={locale} title={entry.data.title} description={entry.data.description} schema={projectSchema(project, locale)}>
  <article id="case-study-heading" class="case-study" data-case-study={project.id}>
    <nav class="case-breadcrumb" aria-label={copy.breadcrumb}><ol><li><a href={localizedPath(locale)}>{ui[locale].home}</a></li><li><a href={localizedPath(locale, '/projects/')}>{ui[locale].projects}</a></li><li aria-current="page">{project.title}</li></ol></nav>
    <header class="case-hero">
      <div class="case-hero__copy">
      <p class="eyebrow">{copy.caseLabel} · {project.categories.map(id => categories[id][locale]).join(' · ')}</p>
      <h1>{project.title}</h1>
      <p class="case-hero__angle">{project.angle[locale]}</p>
      <p class="lead">{project.shortDescription[locale]}</p>
      <VideoDemoLink project={project} locale={locale} />
      <div class="cluster" aria-label={copy.mainTechnologies}>{heroTechnologies.map(id => <TechTag locale={locale} technology={id} />)}</div>
      <div class="case-hero__links"><ExternalLink href={project.githubUrl}>{copy.repository}<span class="sr-only"> — {project.title}</span></ExternalLink><a class="text-link" href={localizedPath(locale, '/projects/')}>← {ui[locale].back}</a></div>
      </div><ShowcaseVisual projectId={project.id} locale={locale} />
    </header>
    <nav class="case-navigation" aria-label={copy.inStudy}><ul>{nav.map(item => <li><a href={`#${item.slug}`}>{item.text}</a></li>)}</ul></nav>
    <div class="case-body">
      <section aria-labelledby="overview"><h2 id="overview">{story.title[locale]}</h2><p class="case-intro">{entry.data.overview}</p><ol class="case-journey">{story.phases.map((phase, index) => <li><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><h3>{phase.title[locale]}</h3><p>{phase.body[locale]}</p></li>)}</ol></section>
      <section aria-labelledby="features"><h2 id="features">{story.featuresTitle[locale]}</h2><ul class="case-features">{project.mainFeatures[locale].map(feature => <li>{feature}</li>)}</ul><ProjectFacts project={project} locale={locale} /></section>
      <section aria-labelledby="architecture"><h2 id="architecture">{story.architectureTitle[locale]}</h2><p>{project.architecture?.[locale]}</p><div class="architecture-grid">{entry.data.diagrams?.map(diagram => <ArchitectureDiagram {...diagram} locale={locale} id={`${project.id}-${diagram.id}`} />)}</div></section>
      <section aria-labelledby="complete-stack"><h2 id="complete-stack">{copy.stack}</h2><div class="cluster">{project.technologies.map(id => <TechTag locale={locale} technology={id} />)}</div></section>
      <div class="case-prose"><Content /></div>
      <section aria-labelledby="demonstrates"><h2 id="demonstrates">{copy.demonstrates}</h2><ul class="demonstrated-skills">{demonstrated.map(id => <li>{project.technologies.includes(id) ? <a href={`${localizedPath(locale, '/projects/')}?technology=${encodeURIComponent(id)}`}>{skillName(id, locale)}</a> : <span>{skillName(id, locale)}</span>}</li>)}</ul></section>
      <section aria-labelledby="related-projects"><h2 id="related-projects">{copy.related}</h2><ul class="case-related">{related.map(relation => <li><a href={localizedPath(locale, `/projects/${relation.project.slug}/`)}>{relation.project.shortTitle ?? relation.project.title}</a><p>{[...relation.technologies.map(id => technologyNames.get(id)), ...relation.categories.map(id => categories[id][locale])].join(' · ')}</p></li>)}</ul></section>
      <footer class="case-repository"><h2>{copy.explore}</h2><p>{copy.repositoryHint}</p><ExternalLink href={project.githubUrl}>{ui[locale].repository}<span class="sr-only"> — {project.title}</span></ExternalLink></footer>
    </div>
  </article>
</BaseLayout>
<script>
  const navigation = document.querySelector<HTMLElement>('.case-navigation');
  if (navigation && 'IntersectionObserver' in window) {
    const links = [...navigation.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const markActive = (id: string) => {
      for (const link of links) {
        if (decodeURIComponent(link.hash.slice(1)) === id) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      }
    };
    navigation.addEventListener('click', event => {
      const link = (event.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
      if (link) markActive(decodeURIComponent(link.hash.slice(1)));
    });
    const observer = new IntersectionObserver(entries => {
      const active = entries.filter(entry => entry.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
      if (!active) return;
      markActive(active.target.id);
    }, { rootMargin: '-20% 0px -55% 0px' });
    links.forEach(link => { const heading = document.getElementById(decodeURIComponent(link.hash.slice(1))); if (heading) observer.observe(heading); });
  }
</script>
